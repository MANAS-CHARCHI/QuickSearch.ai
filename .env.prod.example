# =============================================================================
# Vault City AI - Production Environment Configuration Template
# Copy this to .env.prod and update with your production secrets
# =============================================================================

# Application Core
ENVIRONMENT=production
PROJECT_NAME="Vault City AI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
SECRET_KEY=replace_with_64_char_secure_random_key

# Inbound Domain & CORS (Your real production domain)
ALLOWED_ORIGINS=["https://vaultcity.yourdomain.com"]
FRONTEND_URL=https://vaultcity.yourdomain.com

# Database (PostgreSQL 16 + pgvector container in vault_prod_net)
POSTGRES_USER=vault_prod_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=vault_prod_db
DATABASE_URL=postgresql+asyncpg://vault_prod_user:replace_with_strong_db_password@db:5432/vault_prod_db
VECTOR_DIMENSION=384

# Redis (Redis 7 container in vault_prod_net)
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0

# Cookie Security (Enforces HTTPS-only cookies in production)
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Serverless Object Storage: AWS S3 (Replaces MinIO)
# Leave MINIO_ENDPOINT_URL empty so boto3 connects to native AWS S3 endpoints
MINIO_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
MINIO_REGION=us-east-1
S3_QUARANTINE_BUCKET=vault-quarantine
S3_SECURED_BUCKET=vault-secured

# Antivirus: AWS Lambda ClamAV Scanner
# API Gateway endpoint pointing to your deployed ClamAV Lambda function
USE_SAM_PIPELINE=True
SAM_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Vision Engine (Optional Cloud LLM: Anthropic Claude / Gemini)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=

# Cloudflare Turnstile Bot Protection
TURNSTILE_ENABLED=True
TURNSTILE_SITE_KEY=0x4AAAAAAGDGaHDA7lQB_a7O
TURNSTILE_SECRET_KEY=0x4AAAAAAGDGaBY2ZuBeRJzSHM3qBN27njY

# Google Social Auth
GOOGLE_CLIENT_ID=105470440264-7ep9hin2tddk14jba8agmbddbcl6j12r.apps.googleusercontent.com

# SMTP Email Configuration (Gmail STARTTLS)
SMTP_ENABLED=True
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-notifications@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-notifications@gmail.com
SMTP_FROM_NAME="Vault City AI"
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_VERIFY_SSL=True
