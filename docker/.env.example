# PostgreSQL Configuration
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_secure_password
POSTGRES_DB=vault_db
POSTGRES_PORT=5432

# Backend & Nginx Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# App Secret Key
SECRET_KEY=change-this-to-a-super-secure-random-secret-key-in-prod
DATABASE_URL=postgresql+asyncpg://vault_user:vault_secure_password@db:5432/vault_db
