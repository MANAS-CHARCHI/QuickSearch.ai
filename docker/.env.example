# PostgreSQL Configuration
POSTGRES_USER=vault_user
POSTGRES_PASSWORD=vault_secure_password
POSTGRES_DB=vault_db
POSTGRES_PORT=5432

# Backend & Nginx Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# App Secret Key
SECRET_KEY=change-this-to-a-super-secure-random-secret-key-in-prod
DATABASE_URL=postgresql+asyncpg://vault_user:vault_secure_password@db:5432/vault_db

# Gmail SMTP Configuration (use a 16-char Google App Password: https://myaccount.google.com/apppasswords)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Vault City AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_URL=http://localhost:3000
