# Root .gitignore for Vault City (Personal Vault AI)

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Node.js
**/node_modules/
**/dist/
**/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/env/

# Environment Variables & Secrets
**/.env
**/.env.*
!**/.env.example
!**/.env*.example

# Local Data, Storage & Database files
postgres_data/
**/chroma_db/
**/chroma_data/
**/storage/
**/uploads/
**/*.sqlite3
**/*.db
**/*.log

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo

# Docker volume mounts / temp files
docker_data/
logs/
tmp/
